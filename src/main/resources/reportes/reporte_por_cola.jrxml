	<style name="Detail" fontName="SansSerif" fontSize="9.0" hTextAlign="Center" vTextAlign="Middle">
		<conditionalStyle backcolor="#F2F6FA">
			<conditionExpression><![CDATA[new Boolean($V{REPORT_COUNT}.intValue() % 2 == 0)]]></conditionExpression>
		</conditionalStyle>
	</style>
	<style name="TotalRow" fontName="SansSerif" fontSize="10.0" bold="true" forecolor="#FFFFFF" backcolor="#2C5F8D" hTextAlign="Center" vTextAlign="Middle"/>
	<parameter name="FECHA_INICIO" class="java.util.Date"/>
	<parameter name="FECHA_FIN" class="java.util.Date"/>
	<parameter name="ID_SUCURSAL" class="java.lang.Long"/>
	<query language="SQL"><![CDATA[SELECT sucursal,
	cola,
	fecha,
	total_turnos,
	total_atendidos,
	total_pendientes,
	total_abandonados,
	promedio_espera,
	promedio_atencion,
	promedio_total,
	atencion_mas_rapida,
	atencion_mas_lenta
FROM tomaturno.v_reporte_por_cola
WHERE 
	 tomaturno.v_reporte_por_cola.fecha BETWEEN $P{FECHA_INICIO} AND $P{FECHA_FIN} 
	 AND ( 
	 $P{ID_SUCURSAL} IS NULL  
	 OR tomaturno.v_reporte_por_cola.idsucursal = $P{ID_SUCURSAL}) 
ORDER BY tomaturno.v_reporte_por_cola.sucursal DESC,
	tomaturno.v_reporte_por_cola.total_turnos DESC]]></query>
	<field name="sucursal" class="java.lang.String"/>
	<field name="cola" class="java.lang.String"/>
	<field name="fecha" class="java.sql.Date"/>
	<field name="total_turnos" class="java.lang.Long"/>
	<field name="total_atendidos" class="java.lang.Long"/>
	<field name="total_pendientes" class="java.lang.Long"/>
	<field name="total_abandonados" class="java.lang.Long"/>
	<field name="promedio_espera" class="java.math.BigDecimal"/>
	<field name="promedio_atencion" class="java.math.BigDecimal"/>
	<field name="promedio_total" class="java.math.BigDecimal"/>
	<field name="atencion_mas_rapida" class="java.math.BigDecimal"/>
	<field name="atencion_mas_lenta" class="java.math.BigDecimal"/>
	<variable name="sum_turnos" class="java.lang.Long" calculation="Sum">
		<expression><![CDATA[$F{total_turnos} == null ? 0L : $F{total_turnos}]]></expression>
	</variable>
	<variable name="sum_atendidos" class="java.lang.Long" calculation="Sum">
		<expression><![CDATA[$F{total_atendidos} == null ? 0L : $F{total_atendidos}]]></expression>
	</variable>
	<variable name="sum_pendientes" class="java.lang.Long" calculation="Sum">
		<expression><![CDATA[$F{total_pendientes} == null ? 0L : $F{total_pendientes}]]></expression>
	</variable>
	<variable name="sum_abandonados" class="java.lang.Long" calculation="Sum">
		<expression><![CDATA[$F{total_abandonados} == null ? 0L : $F{total_abandonados}]]></expression>
	</variable>
	<variable name="avg_espera" class="java.math.BigDecimal" calculation="Average">
		<expression><![CDATA[$F{promedio_espera} == null ? java.math.BigDecimal.ZERO : $F{promedio_espera}]]></expression>
	</variable>
	<variable name="avg_atencion" class="java.math.BigDecimal" calculation="Average">
		<expression><![CDATA[$F{promedio_atencion} == null ? java.math.BigDecimal.ZERO : $F{promedio_atencion}]]></expression>
	</variable>
	<variable name="avg_total" class="java.math.BigDecimal" calculation="Average">
		<expression><![CDATA[$F{promedio_total} == null ? java.math.BigDecimal.ZERO : $F{promedio_total}]]></expression>
	</variable>
