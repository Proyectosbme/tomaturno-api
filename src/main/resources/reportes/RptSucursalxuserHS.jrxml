	<parameter name="idSucursal" class="java.lang.Integer">
		<description><![CDATA[identificador de susursal]]></description>
		<defaultValueExpression><![CDATA[1]]></defaultValueExpression>
	</parameter>
	<parameter name="usuario" class="java.lang.String">
		<defaultValueExpression><![CDATA["admin"]]></defaultValueExpression>
	</parameter>
	<parameter name="fechaini" class="java.sql.Date"/>
	<parameter name="fechafin" class="java.sql.Date"/>
	<query language="SQL"><![CDATA[--REPORTE DE SUSUCUSAL Y USUARIO HS
SELECT 
    vm.sucursalticket,
    vm.idusuario,
    vm.nombrecompleto,
    vm.cola,
    vm.detalle,
    vm.estado,
    count(*) as turnos,
    -- Promedio minutos de llamada
    CONCAT(
        FLOOR(AVG(EXTRACT(EPOCH FROM (vm.fechallamada - vm.fechacreacion)) / 60) / 60), 
        ' horas con ',
        FLOOR(AVG(EXTRACT(EPOCH FROM (vm.fechallamada - vm.fechacreacion)) / 60) % 60), 
        ' minutos'
    ) AS promedio_llamada,
     CONCAT(
        FLOOR(AVG(EXTRACT(EPOCH FROM (vm.fechafinalizacion - vm.fechallamada)) / 60) / 60), 
        ' horas con ',
        FLOOR(AVG(EXTRACT(EPOCH FROM (vm.fechafinalizacion - vm.fechallamada)) / 60) % 60), 
        ' minutos'
    ) AS promedio_llamada_atencion,
    -- Promedio minutos total
    CONCAT(
        FLOOR(AVG(EXTRACT(EPOCH FROM (vm.fechafinalizacion - vm.fechacreacion)) / 60) / 60), 
        ' horas con ',
        FLOOR(AVG(EXTRACT(EPOCH FROM (vm.fechafinalizacion - vm.fechacreacion)) / 60) % 60), 
        ' minutos'
    ) AS promedio_total 
FROM tomaturno.VWTURNOS3MESES vm 
WHERE vm.idcatalogoestadodetalle IN (3,4) and vm.idsucursalticket = $P{idSucursal}
and vm.fechacreacion::date BETWEEN '2024-01-01' AND '2028-12-31'
GROUP BY vm.sucursalticket, vm.idusuario,
    vm.nombrecompleto,vm.cola, vm.detalle, vm.estado
ORDER BY vm.sucursalticket, vm.cola, vm.detalle;]]></query>
