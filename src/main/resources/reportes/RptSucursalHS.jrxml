<jasperReport name="RptSucursalHS" language="java" columnCount="1" pageWidth="842" pageHeight="595" orientation="Landscape" columnWidth="802" leftMargin="20" rightMargin="20" topMargin="20" bottomMargin="20" uuid="be6b3f64-fcb6-4029-b541-923ec30b99d3">
