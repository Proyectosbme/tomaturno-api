<jasperReport name="RptSucursalxusuario" language="java" columnCount="1" pageWidth="842" pageHeight="595" columnWidth="802" leftMargin="20" rightMargin="20" topMargin="20" bottomMargin="20" uuid="be6b3f64-fcb6-4029-b541-923ec30b99d3">
	<property name="com.jaspersoft.studio.data.sql.tables" value=""/>
	<property name="com.jaspersoft.studio.data.defaultdataadapter" value="tomaturno"/>
	<property name="com.jaspersoft.studio.data.sql.SQLQueryDesigner.sash.w1" value="217"/>
	<property name="com.jaspersoft.studio.data.sql.SQLQueryDesigner.sash.w2" value="777"/>
	<parameter name="idSucursal" class="java.lang.Integer">
		<description><![CDATA[identificador de susursal]]></description>
		<defaultValueExpression><![CDATA[1]]></defaultValueExpression>
	</parameter>
	<parameter name="usuario" class="java.lang.String">
		<defaultValueExpression><![CDATA["admin"]]></defaultValueExpression>
	</parameter>
	<query language="SQL"><![CDATA[SELECT 
    vm.sucursalticket,
    vm.idusuario,
    vm.nombrecompleto,
    vm.cola,
    vm.detalle,
    vm.estado,
    count(*) as turnos,
    -- Promedio minutos de llamada
    CONCAT(
        FLOOR(AVG(EXTRACT(EPOCH FROM (vm.fechallamada - vm.fechacreacion)) / 60) / 60), 
        ' horas con ',
        FLOOR(AVG(EXTRACT(EPOCH FROM (vm.fechallamada - vm.fechacreacion)) / 60) % 60), 
        ' minutos'
    ) AS promedio_llamada,
     CONCAT(
        FLOOR(AVG(EXTRACT(EPOCH FROM (vm.fechafinalizacion - vm.fechallamada)) / 60) / 60), 
        ' horas con ',
        FLOOR(AVG(EXTRACT(EPOCH FROM (vm.fechafinalizacion - vm.fechallamada)) / 60) % 60), 
        ' minutos'
    ) AS promedio_llamada_atencion,
    -- Promedio minutos total
    CONCAT(
        FLOOR(AVG(EXTRACT(EPOCH FROM (vm.fechafinalizacion - vm.fechacreacion)) / 60) / 60), 
        ' horas con ',
        FLOOR(AVG(EXTRACT(EPOCH FROM (vm.fechafinalizacion - vm.fechacreacion)) / 60) % 60), 
        ' minutos'
    ) AS promedio_total 
FROM tomaturno.VWTURNOSHOY vm 
WHERE vm.idcatalogoestadodetalle IN (3,4) and vm.idsucursalticket = $P{idSucursal}
GROUP BY vm.sucursalticket,vm.idusuario,
    vm.nombrecompleto, vm.cola, vm.detalle, vm.estado
ORDER BY vm.sucursalticket, vm.cola, vm.detalle;]]></query>
